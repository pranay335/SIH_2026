PORT=5000
MONGODB_URI=mongodb://localhost:27017/complaints_db
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# ANTHROPIC_API_KEY is the active classification provider — complaintController.js
# calls claudeService.js, which uses Claude's vision + tool-use API for structured,
# schema-enforced complaint classification.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Groq is kept as an available alternative provider (backend/src/services/groqService.js)
# but is not currently wired into complaintController.js.
GROQ_API_KEY=
# qwen/qwen3.6-27b is Groq's vision+JSON-mode capable model — required for image classification to work.
# Do NOT swap in a text-only model (e.g. openai/gpt-oss-20b) — it silently disables image analysis.
GROQ_MODEL=qwen/qwen3.6-27b

# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/complaints_db
